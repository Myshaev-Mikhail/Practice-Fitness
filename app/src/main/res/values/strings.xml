    <string name="privacy_intro">Your privacy is important to us. This Privacy Policy explains how we collect, use, and protect your personal information when you use our fitness mobile application.</string>
    <string name="privacy_collect_title">1. Information We Collect</string>
    <string name="privacy_collect_body">• Email address\n• Google account information\n• Gender\n• Age\n• Height\n• Weight\n• Fitness level\n• Personal fitness goals\n\nThis information is required to personalize your training experience and provide accurate fitness recommendations.</string>
    <string name="privacy_use_title">2. How We Use Your Information</string>
    <string name="privacy_use_body">• Create and manage your account\n• Personalize workouts and recommendations\n• Track progress and achievements\n• Improve app functionality\n\nWe do not sell or share your personal data with third parties.</string>
    <string name="privacy_security_title">3. Data Security</string>
    <string name="privacy_security_body">Your data is stored securely using modern security technologies and protected from unauthorized access.</string>
    <string name="privacy_third_party_title">4. Third-Party Services</string>
    <string name="privacy_third_party_body">The app may use third-party services such as Google Authentication. These services follow their own privacy policies.</string>
    <string name="privacy_rights_title">5. Your Rights</string>
    <string name="privacy_rights_body">You can access, update, or delete your personal data at any time through the app.</string>
    <string name="privacy_retention_title">6. Data Retention</string>
    <string name="privacy_retention_body">We retain your personal data only for as long as your account is active or as needed to provide our services.</string>
    <string name="privacy_changes_title">7. Changes to This Policy</string>
    <string name="privacy_changes_body">We may update this Privacy Policy from time to time.\nAny changes will be reflected within the app.</string>
    <string name="privacy_contact_title">8. Contact Us</string>
    <string name="privacy_contact_body">If you have any questions about this Privacy Policy or your data, please contact us via the support section in the app.</string>
    <string name="privacy_agreement">By using this application, you agree to this Privacy Policy.</string>
